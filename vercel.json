{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "src/server.js",
      "functions": { "src/server.js": { "includeFiles": "src/db/postgres-schema.sql", "maxDuration": 60 } }
    },
    "frontend": { "root": "frontend", "framework": "vite", "buildCommand": "VITE_MAX_UPLOAD_MB=4 npm run build" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/health", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
